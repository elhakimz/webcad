{
  "id": "transform_translate",
  "name": "Translate Box (2x2x2 by +3,+4,+5)",
  "description": "Create a 2x2x2 box at origin, translate by (3,4,5). Volume stays 8, bbox shifts.",
  "script": {
    "name": "transform_translate_test",
    "steps": [
      {
        "name": "create_box",
        "parameters": {
          "x": 0, "y": 0, "z": 0,
          "dx": 2, "dy": 2, "dz": 2,
          "deflection": 0.1,
          "entity_id": "base_box"
        }
      },
      {
        "name": "transform_shape",
        "parameters": {
          "dx": 3, "dy": 4, "dz": 5,
          "deflection": 0.1,
          "entity_id": "base_box",
          "target_entity_id": "translated_box"
        }
      }
    ]
  },
  "expected": {
    "volume": 8.0,
    "surfaceArea": 24.0,
    "bbox": { "min": [3.0, 4.0, 5.0], "max": [5.0, 6.0, 7.0] },
    "faceCount": 6,
    "edgeCount": 12,
    "vertexCount": 8,
    "isValid": true
  },
  "tolerances": {
    "volume": 1e-4,
    "surfaceArea": 1e-4,
    "bbox": 1e-3,
    "counts": 0
  }
}
